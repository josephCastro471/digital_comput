# PostgreSQL (Neon en produccion, o local mientras se prueba) - cadena de conexion completa
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# JWT
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin unico del sistema
ADMIN_USERNAME=admin
# Hash bcrypt de la contrasena (ver README para generarlo), nunca la contrasena en texto plano
ADMIN_PASSWORD_HASH=
